policy_module(nixos)

gen_require(`
	attribute domain;
	type initrc_t;
	type init_t;
	type var_run_t;
')

########################################
# Declarations
#

# Content of the Nix store that no more specific rule matches.
type nix_store_t;
files_type(nix_store_t)
files_mountpoint(nix_store_t)

# Nix state outside the store: database, profiles, garbage collector roots.
type nix_var_t;
files_type(nix_var_t)

########################################
# Policy
#

# The store is world-readable by design and every program lives in it,
# so every domain may read it. Executing needs a more specific type.
allow domain nix_store_t:dir list_dir_perms;
allow domain nix_store_t:file { read_file_perms map };
allow domain nix_store_t:lnk_file read_lnk_file_perms;

# NixOS mounts the store nosuid, and every executable lives there. The
# kernel then refuses a domain transition unless this is allowed; the
# transition itself still needs its own rule.
allow domain domain:process2 nosuid_transition;

# /run/current-system and /run/booted-system point into the store and
# are followed by every program that looks for a tool or a setting. They
# are replaced on every switch, and a fresh one carries the generic
# runtime type until the next boot labels it.
allow domain var_run_t:lnk_file read_lnk_file_perms;

# Programs carry generic types unless the system configuration names
# them by exact store path, so services start in the generic service
# domain. Leave that domain unconfined: confinement is opt-in.
optional_policy(`
	unconfined_domain(initrc_t)
')

# systemd's helper daemons live under lib/systemd and carry a generic
# library type, so they stay in the init domain instead of entering
# their own. logind starts session scopes from there. Giving the helpers
# their reference policy domains by exact store path is future work.
allow init_t self:system { disable enable start stop };

# Login programs (login, sshd) carry generic types too and run in the
# generic service domain, so that domain starts user sessions and must
# be able to change the SELinux user and role when it does.
domain_subj_id_change_exemption(initrc_t)
domain_role_change_exemption(initrc_t)

# Seen at boot: PCRE just-in-time compilation in grep, and agetty.
allow initrc_t self:process execmem;
allow initrc_t self:capability2 checkpoint_restore;

# The reference policy lets sshd start sessions only in its own user
# domains. Logins here are mapped to the unconfined user.
optional_policy(`
	gen_require(`
		type sshd_t;
		type unconfined_t;
	')

	unconfined_shell_domtrans(sshd_t)
	allow sshd_t unconfined_t:process { noatsecure rlimitinh siginh };
')
