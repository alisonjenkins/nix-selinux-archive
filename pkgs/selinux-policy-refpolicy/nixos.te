policy_module(nixos)

gen_require(`
	attribute domain;
	type initrc_t;
	type init_t;
	type var_run_t;
')

########################################
# Declarations
#

# Content of the Nix store that no more specific rule matches.
type nix_store_t;
files_type(nix_store_t)
files_mountpoint(nix_store_t)

# Nix state outside the store: database, profiles, garbage collector roots.
type nix_var_t;
files_type(nix_var_t)

########################################
# Policy
#

# The store is world-readable by design and every program lives in it,
# so every domain may read it. Executing needs a more specific type.
allow domain nix_store_t:dir list_dir_perms;
allow domain nix_store_t:file { read_file_perms map };
allow domain nix_store_t:lnk_file read_lnk_file_perms;

# NixOS mounts the store nosuid, and every executable lives there. The
# kernel then refuses a domain transition unless this is allowed; the
# transition itself still needs its own rule.
allow domain domain:process2 nosuid_transition;

# /run/current-system and /run/booted-system point into the store and
# are followed by every program that looks for a tool or a setting. They
# are replaced on every switch, and a fresh one carries the generic
# runtime type until the next boot labels it.
allow domain var_run_t:lnk_file read_lnk_file_perms;

# Nix profiles and garbage collector roots under /nix/var are symlinks
# into the store that programs follow to find their files.
allow domain nix_var_t:dir list_dir_perms;
allow domain nix_var_t:lnk_file read_lnk_file_perms;

# /etc on NixOS is a farm of symlinks into the store, including files
# that have their own types elsewhere, such as the SELinux configuration
# that every program linked against libselinux reads.
files_read_etc_files(domain)

# Programs carry generic types unless the system configuration names
# them by exact store path, so services start in the generic service
# domain. Leave that domain unconfined: confinement is opt-in.
optional_policy(`
	unconfined_domain(initrc_t)
')

# systemd's helper daemons live under lib/systemd and carry a generic
# library type, so they stay in the init domain instead of entering
# their own. logind starts session scopes from there. Giving the helpers
# their reference policy domains by exact store path is future work.
allow init_t self:system { disable enable start stop };

# Login programs (login, sshd) carry generic types too and run in the
# generic service domain, so that domain starts user sessions and must
# be able to change the SELinux user and role when it does.
domain_subj_id_change_exemption(initrc_t)
domain_role_change_exemption(initrc_t)

# Seen at boot: PCRE just-in-time compilation in grep, and agetty.
allow initrc_t self:process execmem;
allow initrc_t self:capability2 checkpoint_restore;

# The reference policy lets sshd start sessions only in its own user
# domains. Logins here are mapped to the unconfined user.
optional_policy(`
	gen_require(`
		type sshd_t;
		type unconfined_t;
	')

	unconfined_shell_domtrans(sshd_t)
	allow sshd_t unconfined_t:process { noatsecure rlimitinh siginh };
')

# NixOS runs nsncd in place of nscd. It is a threaded Rust program and
# asks for its scheduling policy at start.
optional_policy(`
	gen_require(`
		type nscd_t;
	')

	allow nscd_t self:process getsched;
')

########################################
# systemd helper daemons
#
# With their programs named by exact store path, systemd's helpers run
# in the domains the reference policy has for them. The rules below
# cover what the policy does not yet allow them: some are NixOS
# specifics, most are behaviour of systemd releases newer than the
# policy.

gen_require(`
	type cgroup_t;
	type etc_runtime_t;
	type fs_t;
	type init_runtime_t;
	type kernel_t;
	type lib_t;
	type nsfs_t;
	type ramfs_t;
	type syslogd_t;
	type systemd_generator_t;
	type systemd_journal_init_t;
	type systemd_journal_t;
	type systemd_logind_t;
	type systemd_machine_id_setup_t;
	type systemd_modules_load_t;
	type systemd_tmpfiles_t;
	type systemd_user_runtime_dir_t;
	type systemd_userdbd_runtime_t;
	type tmpfs_t;
	type tty_device_t;
	type udev_t;
	type user_runtime_t;
	type var_log_t;
')

# Memory pressure notifications, which every long-running systemd
# daemon subscribes to in its own control group.
allow { syslogd_t systemd_logind_t udev_t } cgroup_t:file rw_file_perms;
allow systemd_modules_load_t cgroup_t:file read_file_perms;

# Service credentials are passed on a small tmpfs under /run/credentials.
allow syslogd_t tmpfs_t:dir search_dir_perms;

# udev keeps state in a sealed memory file across re-execution, and
# takes over the kernel event socket opened before the policy was
# loaded in the initrd.
allow udev_t tmpfs_t:file rw_file_perms;
allow udev_t kernel_t:netlink_kobject_uevent_socket { getattr read write };

# logind serves its varlink interface next to the D-Bus one.
allow systemd_logind_t init_runtime_t:sock_file manage_sock_file_perms;
optional_policy(`
	gen_require(`
		type sshd_t;
	')

	allow sshd_t systemd_logind_t:unix_stream_socket connectto;
')

# The helper that creates /run/user/<uid> looks the user up.
allow systemd_user_runtime_dir_t systemd_userdbd_runtime_t:sock_file write_sock_file_perms;
allow systemd_user_runtime_dir_t init_t:unix_stream_socket connectto;
optional_policy(`
	nscd_use(systemd_user_runtime_dir_t)
')
optional_policy(`
	dbus_system_bus_client(systemd_user_runtime_dir_t)
')

allow systemd_tmpfiles_t user_runtime_t:dir search_dir_perms;

# NixOS declares the layout of /nix/var, root's channel list and the
# /run/keys ramfs as tmpfiles rules.
allow systemd_tmpfiles_t nix_var_t:dir manage_dir_perms;
allow systemd_tmpfiles_t nix_var_t:file manage_file_perms;
allow systemd_tmpfiles_t nix_var_t:lnk_file manage_lnk_file_perms;
allow systemd_tmpfiles_t ramfs_t:dir { getattr search setattr };
# NixOS marks /var/empty immutable.
allow systemd_tmpfiles_t self:capability linux_immutable;

# The dynamic loader stub NixOS installs in /lib64 is a symlink.
allow systemd_tmpfiles_t lib_t:lnk_file manage_lnk_file_perms;

allow systemd_machine_id_setup_t self:process getcap;
allow systemd_machine_id_setup_t { fs_t nsfs_t }:filesystem getattr;

# journalctl run as a system service, for example to rebuild the
# catalog or to flush the journal.
allow systemd_journal_init_t var_log_t:dir search_dir_perms;
allow systemd_journal_init_t systemd_journal_t:file map;
allow systemd_journal_init_t etc_runtime_t:file read_file_perms;
allow systemd_journal_init_t tty_device_t:chr_file rw_chr_file_perms;

# dbus-broker subscribes to systemd's unit state to activate services.
optional_policy(`
	gen_require(`
		type system_dbusd_t;
	')

	allow system_dbusd_t init_t:system status;
')
